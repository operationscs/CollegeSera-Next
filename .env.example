# ──────────────────────────────────────────────────────────────
# CollegeSera (Next.js) – environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# ──────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED: all data) ───────────────────────────────
# PUBLIC (bundled to browser by design – anon key is protected by Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site (OPTIONAL) ─────────────────────────────────────────────
# PUBLIC canonical origin used for canonical URLs / sitemap / JSON-LD
NEXT_PUBLIC_SITE_URL=https://collegesera.com

# ── Legacy names (only read by scripts/*.js for backwards compatibility) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
